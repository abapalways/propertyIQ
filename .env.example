# LLM provider: this project uses a LOCAL LLM via Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI (unused now that we run on Ollama; left here harmlessly)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LangSmith observability / tracing (works with a local model too)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-langsmith-api-key-here
LANGCHAIN_PROJECT=PropertyIQ

# ChromaDB persistence directory
CHROMA_DB_DIR=chroma_db
